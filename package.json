{
  "name": "nuito",
  "private": true,
  "version": "0.4.2",
  "type": "module",
  "scripts": {
    "dev": "npm run db:migrate:local && concurrently -k -n app,worker -c cyan,magenta \"npm:dev:app\" \"npm:dev:worker\"",
    "dev:app": "vite --mode development",
    "dev:worker": "wrangler dev --local --port 8787",
    "dev:staging": "vite --mode staging",
    "dev:production": "vite --mode production",
    "build": "tsc -b && vite build",
    "build:staging": "tsc -b && vite build --mode staging",
    "check:deploy:staging": "npm run build:staging && wrangler deploy --config wrangler.staging.jsonc --dry-run",
    "check:deploy:production": "npm run build && wrangler deploy --config wrangler.production.jsonc --dry-run",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "db:migrate:local": "wrangler d1 migrations apply nuito-local --local"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "dexie": "^4.2.0",
    "dexie-react-hooks": "^4.2.0",
    "leaflet": "^1.9.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260915.1",
    "@eslint/js": "^9.35.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/leaflet": "^1.9.20",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^10.0.5",
    "eslint": "^9.35.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "jsdom": "^30.0.1",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.43.0",
    "vite": "^7.1.5",
    "vitest": "^5.0.1",
    "wrangler": "^4.131.2"
  },
  "engines": {
    "node": ">=22.12"
  }
}
